# Copy this file to ".env" and fill in values for the LETLAKA project.
# Use a NEW Supabase project and a NEW EmailJS setup for this client —
# do not reuse keys from another site. Never commit the real ".env".
# Everything is optional: with nothing set, the forms still work by opening
# a pre-filled WhatsApp message.

# Supabase (supabase.com → Project Settings → API)
VITE_SUPABASE_URL=https://puounxemompdvsshvehr.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_IsJwUIMzbVbQPBELup1ZYQ__uS1ToJA

# EmailJS (emailjs.com) — email notification when a form is submitted
VITE_EMAILJS_SERVICE_ID=your-service-id
VITE_EMAILJS_PUBLIC_KEY=your-public-key
VITE_EMAILJS_ORDER_TEMPLATE_ID=your-custom-order-template-id
VITE_EMAILJS_CONTACT_TEMPLATE_ID=your-contact-template-id
# Optional: a separate template for basket orders (variables: name phone email deadline notes items total).
# If left out, the custom-order template is reused.
VITE_EMAILJS_BASKET_TEMPLATE_ID=

# Cloudinary (cloudinary.com) — product photo storage for the admin panel
VITE_CLOUDINARY_CLOUD_NAME=olc9xbfi
VITE_CLOUDINARY_UPLOAD_PRESET=letlaka_products

# Demo mode only (no Supabase): passcode for #/admin. Default: letlaka-demo
VITE_ADMIN_DEMO_PASSCODE=letlaka-demo

